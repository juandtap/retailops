# RetailOps: datos completos y capas materializadas; conservar contratos y esquemas.
/data/source/
/data/raw/
/data/bronze/
/data/silver/
/data/gold/
*.csv
*.tsv
*.parquet
*.parq
*.arrow
*.feather
*.npy
*.npz
# Excepciones para muestras pequeñas revisadas y fixtures; nunca para Favorita completo.
!**/tests/fixtures/**/*.csv
!**/tests/fixtures/**/*.tsv
!**/tests/fixtures/**/*.parquet
!/data/examples/*.csv
!/data/examples/*.tsv

# Secretos y configuración privada; ejemplos seguros sí se versionan.
.env
.env.*
!.env.example
!.env.*.example
**/secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
id_dsa
.netrc
.pypirc
.npmrc.local
/credentials.json
/credentials.yaml
/credentials.yml
/secrets.json
/secrets.yaml
/secrets.yml
/.aws/
/.codex/
/.agents/

# Python / uv: los pyproject.toml, uv.lock y scripts se conservan.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.lcov

# Jupyter: notebooks fuente sí; estado de kernel y checkpoints no.
.ipynb_checkpoints/
notebooks/.jupyter/
notebooks/.ipython/

# Java / Maven: conservar pom.xml, mvnw y .mvn/wrapper/.
target/
*.class
.mvn/timing.properties
.gradle/

# React / TypeScript / Vite: conservar manifests, lockfiles y configuración.
node_modules/
dist/
dist-ssr/
.vite/
.vite-temp/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Runtime local, caches, temporales y logs (incluye Python gestionado y secretos).
.local/
/tmp/
/temp/
logs/
*.log
*.log.*
*.pid
*.pid.lock
*.tmp
*.temp
*.swp
*.swo
*~

# Modelos serializados y artefactos MLflow generados, no código de modelos.
mlruns/
mlartifacts/
/artifacts/
*.skops
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.hdf5

# Bases locales, dumps y backups; NO ignorar .sql (Flyway y fixtures).
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.dump
*.sql.gz
*.sql.bz2
*.bak
*.backup
backups/

# Bind mounts de datos: los volúmenes nombrados actuales no están en el repositorio.
/infra/docker/volumes/
/infra/docker/runtime/
pgdata/
postgres_data/
minio_data/

# Airflow futuro: runtime local; conservar DAGs, plugins y configuración declarativa.
/airflow/airflow.cfg
/airflow/runtime/
standalone_admin_password.txt

# K3s / Helm futuros: conservar charts/manifests, excluir identidad y runtime local.
.kube/
kubeconfig
kubeconfig.*
*.kubeconfig
!kubeconfig.example
!kubeconfig.example.*
!kubeconfig.*.example
/infra/k3s/runtime/
/infra/k3s/node-token
/infra/k3s/server/token

# Observabilidad futura: conservar reglas, dashboards y configuración.
prometheus_data/
grafana_data/
loki_data/
**/prometheus/data/
**/grafana/data/
**/loki/data/
**/loki/chunks/
**/loki/index/
**/loki/wal/

# Estado personal del editor y del sistema operativo.
.idea/
.vscode/
.DS_Store
Thumbs.db
