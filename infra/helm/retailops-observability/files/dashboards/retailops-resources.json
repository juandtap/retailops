{
  "uid": "retailops-resources",
  "title": "RetailOps · Recursos desde metrics-server",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "retailops",
    "f5.1"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "CPU observada por contenedor, cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "retailops_kubernetes_container_cpu_cores",
          "legendFormat": "{{namespace}} / {{pod}} / {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
