        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "retailops:sli_latency:p95_5m",
          "legendFormat": "{{service}} {{alertname}} {{container}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
