      "targets": [
        {
          "refId": "A",
          "expr": "retailops:sli_non5xx:ratio5m",
          "legendFormat": "{{service}} {{alertname}} {{container}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
