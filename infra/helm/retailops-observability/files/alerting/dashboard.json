    },
    {
      "id": 7,
      "title": "Memoria pods / límite",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "retailops_kubernetes_container_memory_working_set_bytes / retailops_kubernetes_container_memory_limits_bytes",
          "legendFormat": "{{service}} {{alertname}} {{container}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [
