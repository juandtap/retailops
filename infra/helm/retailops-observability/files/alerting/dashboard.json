{
  "uid": "retailops-sre",
  "title": "RetailOps · Alertas y SLO propuestos",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "retailops",
    "f5.3"
  ],
  "description": "Propuestas de laboratorio. Sin datos o NaN no significa éxito; excludes apagados, ML sin tráfico /predict carece de SLI HTTP.",
  "links": [
    {
      "title": "Alertmanager local: grupos y silencios",
      "type": "link",
      "url": "http://127.0.0.1:9094"
    },
    {
      "title": "Logs correlacionados",
      "type": "link",
      "url": "/d/retailops-logs"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Laboratorio activo (0=cierre planificado)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "retailops:lab_active",
          "legendFormat": "{{service}} {{alertname}} {{container}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Logs relacionados: seleccionar servicio y request_id",
              "url": "/d/retailops-logs"
            },
            {
              "title": "Métricas HTTP",
              "url": "/d/retailops-http"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Alertas operativas pendientes o firing",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{scope=\"operational\"}",
          "legendFormat": "{{service}} {{alertname}} {{container}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Logs relacionados: seleccionar servicio y request_id",
              "url": "/d/retailops-logs"
            },
            {
              "title": "Métricas HTTP",
              "url": "/d/retailops-http"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Pruebas sintéticas, separadas de incidentes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{scope=\"validation\"}",
          "legendFormat": "{{service}} {{alertname}} {{container}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Logs relacionados: seleccionar servicio y request_id",
              "url": "/d/retailops-logs"
            },
            {
              "title": "Métricas HTTP",
              "url": "/d/retailops-http"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Disponibilidad observada: scrape API / readiness ML",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "retailops:sli_availability:ratio",
          "legendFormat": "{{service}} {{alertname}} {{container}} {{alertstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [
            {
              "title": "Logs relacionados: seleccionar servicio y request_id",
              "url": "/d/retailops-logs"
            },
            {
              "title": "Métricas HTTP",
              "url": "/d/retailops-http"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Solicitudes sin 5xx (ML solo /predict)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "retailops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
