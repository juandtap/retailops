# Copiar a .env en la raíz y exportar antes de iniciar los servicios.
# Solo configuración pública. F1-02 genera secretos locales con scripts/data_infra.py init-secrets.
API_HOST=127.0.0.1
API_PORT=8080
ML_HOST=127.0.0.1
ML_PORT=8000
# Destino del proxy de desarrollo. Nunca colocar secretos en VITE_*.
WEB_HOST=127.0.0.1
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:8080

# PostgreSQL y MinIO: el helper utiliza .env si existe; si no, este ejemplo.
POSTGRES_DB=retailops
POSTGRES_PORT=5432
POSTGRES_MEMORY=1g
POSTGRES_CPUS=2
MINIO_PORT=9000
MINIO_MEMORY=2g
MINIO_CPUS=2
MINIO_INTERNAL_ENDPOINT=http://minio:9000
# Los archivos en .local/secrets son reales, ignorados y no deben publicarse.
# No colocar contraseñas aquí ni en VITE_*.

# F1-06: tracking local; backend/artefactos tienen secretos propios en archivos.
MLFLOW_PORT=5000
MLFLOW_MEMORY=1g
MLFLOW_CPUS=2
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Activación explícita en FastAPI de una versión ya registrada:
# ML_MODEL_VERSION=1
# MLFLOW_ALLOW_MODEL_CODE_EXECUTION=true  # Solo artefactos propios/confiables.

# F2 Airflow: ejecución local manual, sin publicación ni reentrenamiento por calendario.
AIRFLOW_UID=1000
AIRFLOW_PORT=8081
AIRFLOW_MEMORY=1g
AIRFLOW_SCHEDULER_MEMORY=3g
AIRFLOW_CPUS=2
